{
  "name": "prettier-plugin-tailwind-variants",
  "license": "MIT",
  "version": "0.2.0",
  "description": "A Prettier plugin for Tailwind Variants that formats class arrays while preserving structure, then sorts them with prettier-plugin-tailwindcss",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "tailwind",
    "tailwindcss",
    "tailwind-variants",
    "formatting",
    "class-sorting",
    "variants"
  ],
  "homepage": "https://github.com/tianenpang/prettier-plugin-tailwind-variants#readme",
  "bugs": {
    "url": "https://github.com/tianenpang/prettier-plugin-tailwind-variants/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianenpang/prettier-plugin-tailwind-variants.git"
  },
  "author": {
    "name": "Tianen Pang",
    "url": "https://github.com/tianenpang"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "benchmark": "pnpm build && node benchmark/run.mjs",
    "benchmark:quick": "pnpm build && node benchmark/run.mjs --quick",
    "release-channel": "node --experimental-strip-types ./scripts/release-channel.mts",
    "release-notes": "node --experimental-strip-types ./scripts/release-notes.mts",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.56.8",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "4.3.3",
    "tinybench": "6.1.2",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0"
  },
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=11.x"
  },
  "packageManager": "pnpm@11.18.0"
}
